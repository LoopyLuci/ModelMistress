+// rigel-port.cpp -- the Windows side of rigel-port.h (nothing here on other platforms).
+#include "rigel-port.h"
+
+#if defined(_WIN32)
+
+#include <psapi.h>
+#include <tlhelp32.h>
+
+#include <cstdio>
+#include <cstring>
