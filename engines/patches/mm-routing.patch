+// ModelMistress: expert routing capture.
+// The graph evaluation callback is always installed, but it only asks for the MoE router outputs
+// (`ffn_moe_topk-<layer>`, `ffn_moe_weights-<layer>`) while a decode contains a token of a request with
+// "mm_routing": true. Everything else costs one atomic load per graph node. All of it runs on the decode thread.
+struct mm_routing_capture {
+    struct layer {
+        int32_t k = 0;
+        std::vector<int32_t> ids;     // row-major [n_tokens][k]
+        std::vector<float>   weights; // row-major [n_tokens][k]
+    };
+
+    std::atomic<bool> active{false};
+    std::map<int32_t, layer> layers;
+
+    static bool match(const ggml_tensor * t, const char * prefix, int32_t & il) {
+        const size_t n = strlen(prefix);
+        if (strncmp(t->name, prefix, n) != 0) {
+            return false;
+        }
+        char * end = nullptr;
+        il = (int32_t) strtol(t->name + n, &end, 10);
+        return end != t->name + n && *end == '\0'; // not the "(reshaped)" views
+    }
+
+    static bool cb(ggml_tensor * t, bool ask, void * user_data) {
+        auto * self = static_cast<mm_routing_capture *>(user_data);
+        if (!self->active.load(std::memory_order_relaxed)) {
+            return false;
+        }
+        int32_t il = -1;
+        const bool is_ids = match(t, "ffn_moe_topk-", il);
+        const bool is_w   = !is_ids && match(t, "ffn_moe_weights-", il);
+        if (!is_ids && !is_w) {
+            return false;
+        }
+        if (ask) {
+            return true;
+        }
+
+        // the tensors are views or strided: read the whole extent and walk it with the strides
+        std::vector<uint8_t> raw(ggml_nbytes(t));
+        ggml_backend_tensor_get(t, raw.data(), 0, raw.size());
+        auto & l = self->layers[il];
+        if (is_ids) {
+            if (t->type != GGML_TYPE_I32) {
+                return true;
+            }
+            l.k = (int32_t) t->ne[0];
+            for (int64_t r = 0; r < t->ne[1]; ++r) {
+                for (int64_t j = 0; j < t->ne[0]; ++j) {
+                    int32_t v;
+                    memcpy(&v, raw.data() + r*t->nb[1] + j*t->nb[0], sizeof(v));
+                    l.ids.push_back(v);
+                }
+            }
+        } else {
+            if (t->type != GGML_TYPE_F32) {
+                return true;
+            }
+            for (int64_t r = 0; r < t->ne[2]; ++r) {
+                for (int64_t j = 0; j < t->ne[1]; ++j) {
+                    float v;
+                    memcpy(&v, raw.data() + r*t->nb[2] + j*t->nb[1], sizeof(v));
+                    l.weights.push_back(v);
+                }
+            }
+        }
+        return true;
+    }
+
+    // The routing of one token of the decode that just ran. `row` is the token's index in the sub-batch;
+    // the last layer only computes the rows that are outputs, so it is found by `row_out` instead.
+    std::vector<completion_token_output::mm_route_layer> take(int32_t n_tokens, int32_t n_out, int32_t row, int32_t row_out) const {
+        std::vector<completion_token_output::mm_route_layer> out;
+        for (const auto & [il, l] : layers) {
+            if (l.k <= 0 || l.ids.size() != l.weights.size() || l.ids.size() % l.k != 0) {
+                continue;
+            }
+            const int32_t rows = (int32_t) (l.ids.size() / l.k);
+            int32_t r = -1;
+            if (rows == n_tokens) {
+                r = row;
+            } else if (rows == n_out) {
+                r = row_out;
+            }
+            if (r < 0 || r >= rows) {
+                continue;
+            }
+            completion_token_output::mm_route_layer e;
+            e.layer = il;
+            e.experts.assign(l.ids.begin() + (size_t) r*l.k, l.ids.begin() + (size_t) (r + 1)*l.k);
+            e.weights.assign(l.weights.begin() + (size_t) r*l.k, l.weights.begin() + (size_t) (r + 1)*l.k);
+            out.push_back(std::move(e));
+        }
+        return out;
+    }
+};
